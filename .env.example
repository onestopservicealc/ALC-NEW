# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง — ห้าม commit .env.local
#
#   cp .env.example .env.local
#
# ค่าทั้งหมดหาได้จาก Vercel → Settings → Environment Variables (กดรูปตาเพื่อดูค่า)
# หรือจาก Supabase → Project Settings → API

# ─── ฝั่ง client — ถูกฝังลง bundle ตอน build (ปลอดภัยเพราะมี RLS คุม) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── ฝั่ง server เท่านั้น — ห้ามขึ้นต้นด้วย VITE_ เด็ดขาด ───
# SERVICE_ROLE_KEY ข้าม RLS ได้ทั้งหมด ถ้าตั้งชื่อขึ้นต้นด้วย VITE_
# Vite จะฝังลงไฟล์ JavaScript ที่ทุกคนดาวน์โหลดได้
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
CRON_SECRET=

# ─── ไม่บังคับ — ไม่ใส่ก็ใช้ค่าเริ่มต้นในวงเล็บ ───
# GEMINI_MODEL=                      (gemini-3.7-flash)
# GEMINI_MODEL_FALLBACKS=            (ว่าง — คั่นหลายรุ่นด้วยจุลภาค)
# GEMINI_TIMEOUT_MS=                 (45000)
# HTTP_MIN_INTERVAL_MS=              (350 — เว้นระยะระหว่าง request ต่อโดเมน)
# INGEST_MAX_ARTICLES_PER_TICK=      (40)
# INGEST_MAX_LEADS_PER_TICK=         (15)
# INGEST_MAX_SITEMAP_FETCH_PER_TICK= (150)
# INGEST_TIME_BUDGET_MS=             (250000)
# INGEST_USER_AGENT=                 (AlcoholIncidentWatch/1.0 ...)
# DISABLE_GNEWS_RESOLVE=1            ปิดการถอดลิงก์ Google News ฉุกเฉิน
